NODE_ENV=development
PORT=3000
# Generate a random secret using the command in backend/README.md (32+ characters).
JWT_SECRET=
SESSION_TTL_SECONDS=28800
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=file:./prisma/dev.db
# Optional admin seeding: fill these only when you explicitly run db:seed.
# Public registration always creates USER accounts.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@servicenova.ude
ADMIN_PASSWORD=12345678
