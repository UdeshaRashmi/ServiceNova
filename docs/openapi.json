{
  "openapi": "3.0.3",
  "info": {
    "title": "ServiceNova REST API",
    "version": "0.1.0",
    "description": "Backend application logic is implemented. Persistence adapter is pending; database-backed runtime endpoints return 503. Tests currently use isolated repository doubles. Auth cookies are HttpOnly, SameSite=Lax, and Secure in production. Logout invalidates all user sessions. Mutations require a trusted Origin. Other owners’ request IDs return 404. Admin creation uses a controlled seed in the upcoming database phase."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Same-origin API or Vite proxy"
    }
  ],
  "security": [
    {
      "cookieAuth": []
    },
    {
      "productionCookieAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Requests"
    },
    {
      "name": "Users"
    },
    {
      "name": "Operations"
    }
  ],
